WAZUH_VERSION=4.14.7
WAZUH_IMAGE_VERSION=4.14.7
WAZUH_TAG_REVISION=1
FILEBEAT_TEMPLATE_BRANCH=4.14.7
WAZUH_FILEBEAT_MODULE=wazuh-filebeat-0.5.tar.gz
WAZUH_UI_REVISION=1

# Cloudflare Active Response Configuration
# API token needs "Account > Account Filter Lists > Edit" or WAF permissions
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Slack Webhook for Active Response Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
